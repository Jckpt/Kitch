{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitch",
  "main": "src/index.ts",
  "kv_namespaces": [
    {
      "binding": "KICK_TOKEN_CACHE",
      "id": "85462ff3d58f46cdace2d01d02b9dea4"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}